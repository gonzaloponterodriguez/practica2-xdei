post_update() {
  payload="$1"
  curl -s -o /dev/null -X POST \
    "${ORION_URL}/v2/op/update" \
    -H 'Content-Type: application/json' \
    -d "${payload}"
}

post_json() {
  endpoint="$1"
  payload="$2"
  curl -s -o /dev/null -X POST \
    "${ORION_URL}${endpoint}" \
    -H 'Content-Type: application/json' \
    -d "${payload}"
}

