  \"description\": \"Low stock alerts\",
  \"subject\": {
    \"entities\": [{\"idPattern\": \"urn:ngsi-ld:InventoryItem:.*\", \"type\": \"InventoryItem\"}],
    \"condition\": {
      \"attrs\": [\"stockCount\"],
      \"expression\": {\"q\": \"stockCount<5\"}
