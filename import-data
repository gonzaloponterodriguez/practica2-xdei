shelf_store_pairs="unit001:001 unit002:001 unit003:001 unit004:001 unit005:002 unit006:002 unit007:002 unit008:002 unit009:003 unit010:003 unit011:003 unit012:003 unit013:004 unit014:004 unit015:004 unit016:004"
inventory_entities=""
item_counter=1
shelf_index=0

for pair in $shelf_store_pairs; do
  shelf="${pair%%:*}"
  store="${pair##*:}"
  offset=0
  while [ "$offset" -lt 4 ]; do
    product_num=$(( (shelf_index + offset) % 10 + 1 ))
    product_id=$(printf "%03d" "$product_num")
    inv_id=$(printf "%03d" "$item_counter")
    shelf_count=$(( 8 + (offset * 4) + (shelf_index % 4) ))
    stock_count=$(( 120 + shelf_count + (shelf_index * 3) ))
    obj="{\"id\":\"urn:ngsi-ld:InventoryItem:${inv_id}\",\"type\":\"InventoryItem\",\"refStore\":{\"type\":\"Relationship\",\"value\":\"urn:ngsi-ld:Store:${store}\"},\"refShelf\":{\"type\":\"Relationship\",\"value\":\"urn:ngsi-ld:Shelf:${shelf}\"},\"refProduct\":{\"type\":\"Relationship\",\"value\":\"urn:ngsi-ld:Product:${product_id}\"},\"stockCount\":{\"type\":\"Integer\",\"value\":${stock_count}},\"shelfCount\":{\"type\":\"Integer\",\"value\":${shelf_count}}}"
    if [ -n "$inventory_entities" ]; then
      inventory_entities="${inventory_entities},${obj}"
    else
      inventory_entities="${obj}"
    fi
    item_counter=$((item_counter + 1))
    offset=$((offset + 1))
  done
  shelf_index=$((shelf_index + 1))
done

post_update "{\"actionType\":\"APPEND\",\"entities\":[${inventory_entities}]}"

