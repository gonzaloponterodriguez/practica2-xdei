  },
  \"notification\": {
    \"http\": {\"url\": \"${NOTIFICATION_URL}\"},
    \"attrs\": [\"stockCount\", \"shelfCount\", \"refStore\", \"refProduct\"]
  },
  \"throttling\": 1
}"

